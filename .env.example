# NAVER WORKS Developer Console — delegated service-account app credentials.
# Copy to ./.env (or ~/.config/worksmobile/.env) and fill in. NEVER commit the real file.
# Resolution order: process env (WORKS_*) > $WORKS_ENV_FILE > ./.env > ~/.config/worksmobile/.env

# Client ID / Secret of your delegation-enabled app
WORKS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
WORKS_CLIENT_SECRET=xxxxxxxxxx

# Service-account email (e.g. xxxxxxxx.serviceaccount@yourdomain)
WORKS_SERVICE_ACCOUNT=xxxxxxxx@xxxxxxxx

# Absolute path to the issued private key (PEM). Re-issuing invalidates the old key.
WORKS_PRIVATE_KEY=/home/you/.config/worksmobile/private.key

# Default member to act as (JWT delegated_user) when --user / user= is omitted
WORKS_DEFAULT_USER=admin@yourdomain
